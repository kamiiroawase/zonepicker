<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- supportsRtl stays explicitly off so the host keeps its own app-level RTL setting;
         the picker activity resolves its own layout direction from the locale instead. -->
    <application android:supportsRtl="false">
        <activity
            android:name=".ZonePickerActivity"
            android:exported="false"
            android:theme="@style/Theme.ZonePicker"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
