<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No supportsRtl here: whatever a library declares merges into the host manifest and
         errors against an app that chose the other value (an RTL-enabled host would fail
         to build). The picker activity resolves its own layout direction from the locale
         at runtime instead. -->
    <application>
        <activity
            android:name=".ZonePickerActivity"
            android:exported="false"
            android:theme="@style/Theme.ZonePicker"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
